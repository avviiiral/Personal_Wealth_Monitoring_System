# ------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.swp

# ------------------------------------------------------------
# Generated data
# ------------------------------------------------------------
*.csv
*.xlsx
*.xls
*.jsonl

# Ignore generated/output directories
output/
outputs/
generated/
exports/
/reports/

