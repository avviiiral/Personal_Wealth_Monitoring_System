# Copy this file to .env and fill in real values before deploying.
# .env itself is gitignored - never commit real secrets.

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# AI chat / portfolio news
GEMINI_API_KEY=

# Optional: comma-separated authoritative PMS source endpoints.
# Expected JSON array or CSV with PMS fields documented by the Watch List adapter.
# Leave blank when no reliable source is available; PWMS will not fabricate PMS data.
WATCHLIST_PMS_SOURCE_URLS=
