# Copy this file to .env and fill in real values before deploying.
# .env itself is gitignored - never commit real secrets.
#
# Every value below has a dev-safe default baked into
# config/settings.py, so a missing .env (or a missing individual
# variable) never breaks local dev - these only need to be set for
# a real deployment.

# A real, randomly generated secret - never the placeholder Django
# generates, never committed to git. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# False in any real deployment. True is fine for local dev only.
DEBUG=False

# Comma-separated, no spaces around commas needed. Your actual
# deployed domain(s)/IP(s) - Django rejects every request otherwise
# once DEBUG=False.
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Comma-separated. The frontend's real deployed origin(s) - must be
# the exact scheme+host+port the browser actually loads the
# frontend from (https://, not http://, once you're not on
# localhost).
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# True once served over real HTTPS. Leave False for local
# http://localhost dev - browsers reject Secure cookies over plain
# HTTP entirely, so turning these on before HTTPS is actually in
# place breaks login, not just weakens security.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# Used by the AI chat / portfolio news analysis features
# (ai/views.py, portfolio_news/services/gemini_analyzer.py).
# Without this, those features log a warning and skip analysis
# rather than failing - see ai/views.py's _get_gemini_api_key().
GEMINI_API_KEY=
