.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 24px;

  h2 {
    margin: 0;
    font-size: 18px;
    font-weight: 650;
    color: #111827;
  }

  p {
    margin: 6px 0 0;
    color: #8a93a3;
    font-size: 13px;
  }
}

.primary-button {
  border: 0;
  border-radius: 8px;
  padding: 10px 18px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  background: #111827;
  color: white;
  transition: 0.2s ease;

  &:hover {
    background: #1f2937;
  }

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
}

.new-family-row {
  display: flex;
  gap: 10px;
  margin-bottom: 24px;

  input {
    flex: 1;
    max-width: 360px;
    box-sizing: border-box;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 14px;
  }
}

.loading-row {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #8a93a3;
  font-size: 14px;
  padding: 24px 0;
}

.loading-spinner {
  width: 18px;
  height: 18px;
  border: 2px solid #e5e7eb;
  border-top-color: #111827;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.error-message {
  color: #b42318;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 13px;
}

.families-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 16px;
}

.family-card {
  background: white;
  border: 1px solid #eef0f3;
  border-radius: 12px;
  padding: 16px 18px;
}

.family-card-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 12px;

  strong {
    font-size: 15px;
    color: #111827;
  }
}

.member-count {
  font-size: 12px;
  color: #8a93a3;
  background: #f3f4f6;
  border-radius: 20px;
  padding: 2px 10px;
}

.link-button {
  border: 0;
  background: none;
  color: #374151;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  padding: 0;

  &:hover {
    text-decoration: underline;
  }
}

.danger-link {
  color: #b42318;
}

.rename-input {
  border: 1px solid #d1d5db;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 13px;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fafafa;
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 13px;
}

.member-name {
  color: #111827;
  font-weight: 500;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.also-in {
  font-size: 11px;
  color: #9aa2af;
  white-space: nowrap;
}

.remove-button {
  border: 0;
  background: none;
  color: #9aa2af;
  font-size: 15px;
  cursor: pointer;
  padding: 0 2px;
  line-height: 1;

  &:hover {
    color: #b42318;
  }
}

.no-members {
  color: #9aa2af;
  font-size: 13px;
}

.add-member-row {
  display: flex;
  gap: 10px;
  align-items: center;

  select {
    flex: 1;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
  }
}

// Role badges - kept in sync with user-management.component.scss
.role-badge {
  display: inline-flex;
  padding: 3px 8px;
  border-radius: 20px;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.role-viewer {
  background: #f3f4f6;
  color: #4b5563;
}

.role-admin {
  background: #eef2ff;
  color: #4338ca;
}

.role-superuser {
  background: #fef3c7;
  color: #92400e;
}

.role-system_owner {
  background: #fee2e2;
  color: #991b1b;
}
