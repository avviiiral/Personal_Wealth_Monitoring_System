+def watch_list_bulk_watch(request):
+    product_ids = request.data.get("product_ids") or []
+    if not isinstance(product_ids, list):
+        return Response({"detail": "product_ids must be a list."}, status=400)
+    valid_ids = list(
+        InvestmentProduct.objects.filter(id__in=product_ids, is_active=True).values_list("id", flat=True)
+    )
+    existing = set(
+        WatchedProduct.objects.filter(owner=request.user, product_id__in=valid_ids).values_list(
+            "product_id", flat=True
+        )
+    )
+    to_create = [
+        WatchedProduct(owner=request.user, product_id=product_id)
+        for product_id in valid_ids
+        if product_id not in existing
+    ]
+    if to_create:
+        WatchedProduct.objects.bulk_create(to_create, ignore_conflicts=True)
+    return Response({"added": [product_id for product_id in valid_ids]})
+
